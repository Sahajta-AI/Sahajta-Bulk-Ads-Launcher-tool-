# Copy to .env and fill in. Never commit .env. See docs/SETUP.md for where each value comes from.

# Public address of the app (used in links and by Google sign-in)
APP_URL=https://launcher.sahajta.com
DOMAIN=launcher.sahajta.com
# An earlier address that should forward to DOMAIN (leave empty if none)
OLD_DOMAIN=ads.sahajta.com

# Who may sign in (comma-separated)
ALLOWED_EMAILS=you@yourcompany.com,teammate@yourcompany.com

# 32 random bytes, base64. Encrypts the Meta connection and Google refresh tokens in the database.
# Generate: openssl rand -base64 32   (keep a copy in your password manager: without it the saved tokens can't be read)
APP_ENCRYPTION_KEY=

# Auth.js (Google sign-in)
AUTH_SECRET=                 # openssl rand -base64 32
AUTH_GOOGLE_ID=              # Google OAuth client ID
AUTH_GOOGLE_SECRET=          # Google OAuth client secret

# Meta: the launcher's own app (developers.facebook.com → Sahajta Ads Launcher → App settings → Basic).
# The ad account, Page and Instagram account are not set here: the person using the launcher
# connects them in the app (Settings → Meta connection → Connect Meta).
META_APP_ID=                 # App ID from App settings → Basic
META_APP_SECRET=
# Facebook Login for Business configuration ID (Facebook Login for Business → Configurations).
# Use a configuration with a *user access token* (a normal Facebook login): it lists every ad account
# the person can use, in any business portfolio (agency accounts included). The token lasts 60 days.
# A business-login (system-user) configuration only shows portfolios the person fully controls.
META_LOGIN_CONFIG_ID=

# Contact address shown on the privacy, terms and data-deletion pages
LEGAL_CONTACT_EMAIL=
META_API_VERSION=v26.0

# 1 = practice mode: a fake Meta API, nothing is sent to Meta.
META_MOCK=0

# Database backup: Oracle Object Storage pre-authenticated request URL (write-only, ends with /o/)
BACKUP_PAR_URL=

# Real-account tests only: every name gets this prefix (TEST_). Leave empty in normal use.
NAME_PREFIX=

# Where the database and files live (inside Docker this is /data)
DATA_DIR=data
